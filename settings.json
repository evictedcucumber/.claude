{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "outputStyle": "Orchestrator",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "maxEffortLevel": "high"
    },
    "claude-haiku-5-5": {
      "maxEffortLevel": "high"
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.pgpass)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(**/.env)",
      "Read(//**/.env)",
      "Read(**/.env.local)",
      "Read(//**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(//**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(//**/.env.production)",
      "Read(**/.env.development)",
      "Read(//**/.env.development)",
      "Read(**/.env.staging)",
      "Read(//**/.env.staging)",
      "Read(**/.env.test)",
      "Read(//**/.env.test)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)"
    ]
  }
}
